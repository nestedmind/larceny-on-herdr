#!/usr/bin/env bash
# Fake herdr-app for tests. Appends each call's argv, tab-joined, to
# $FAKE_APP_LOG. `status` exits 0 (a window is open) unless
# FAKE_APP_RUNNING=0, when it prints an error and exits 1. Any other command
# exits with FAKE_APP_EXIT (default 0). `do tab.new` prints {"tab":"tb1"}, then
# tb2 and so on (a counter in $FAKE_APP_LOG.tabs), and fails with
# FAKE_APP_NEW_EXIT when set, writing {"error":"tab.new failed: boom"} to
# stdout like the real one. FAKE_APP_SPACE=0 starts with no space open:
# `status` reports "space": null, `do tab.new` fails with "no space yet" on
# stdout, and `do space.new` (fails with FAKE_APP_SPACE_EXIT when set) opens
# one. `do tab.close` exits with FAKE_APP_CLOSE_EXIT.
set -euo pipefail
: "${FAKE_APP_LOG:?FAKE_APP_LOG must be set}"
(
  IFS=$'\t'
  printf '%s\n' "$*" >>"$FAKE_APP_LOG"
)
if [[ "${1:-}" == "status" ]]; then
  if [[ "${FAKE_APP_RUNNING:-1}" == "0" ]]; then
    echo '{"error":"no herdr-app window"}'
    exit 1
  fi
  if [[ "${FAKE_APP_SPACE:-1}" == "0" && ! -f "$FAKE_APP_LOG.space" ]]; then
    echo '{"errors":[],"space":null,"tab":null}'
  else
    echo '{"errors":[],"space":"spc1","tab":"tb0"}'
  fi
  exit 0
fi
if [[ "${1:-}" == "do" && "${2:-}" == "space.new" ]]; then
  [[ -z "${FAKE_APP_SPACE_EXIT:-}" ]] || { echo '{"error":"space.new failed: boom"}'; exit "$FAKE_APP_SPACE_EXIT"; }
  : >"$FAKE_APP_LOG.space"
  echo '{"space":"spc1"}'
  exit 0
fi
if [[ "${1:-}" == "do" && "${2:-}" == "tab.new" ]]; then
  if [[ "${FAKE_APP_SPACE:-1}" == "0" && ! -f "$FAKE_APP_LOG.space" ]]; then
    echo '{"error": "no space yet: make one first (space.new)"}'
    exit 1
  fi
  [[ -z "${FAKE_APP_NEW_EXIT:-}" ]] || { echo '{"error":"tab.new failed: boom"}'; exit "$FAKE_APP_NEW_EXIT"; }
  n=$(($(cat "$FAKE_APP_LOG.tabs" 2>/dev/null || echo 0) + 1))
  echo "$n" >"$FAKE_APP_LOG.tabs"
  printf '{"space":"spc1","tab":"tb%s","terminal":"t1"}\n' "$n"
  exit 0
fi
if [[ "${1:-}" == "do" && "${2:-}" == "tab.close" ]]; then
  [[ -z "${FAKE_APP_CLOSE_EXIT:-}" ]] || { echo "tab.close failed" >&2; exit "$FAKE_APP_CLOSE_EXIT"; }
  echo '{"ok":true}'
  exit 0
fi
echo '{}'
exit "${FAKE_APP_EXIT:-0}"
